# The FFmpeg the Windows installer ships (scripts/package/windows-msi.ps1),
# from BtbN/FFmpeg-Builds: a GPL build, which has no fdk-aac (BtbN builds that
# only for its "nonfree" variants, which it never publishes), with shared
# libraries (ffmpeg.exe and ffprobe.exe share the DLLs). Each release attaches
# its complete source (scripts/package/ffmpeg-windows-source.sh).
#
# To move to a newer one: take the last autobuild-* release of a month (BtbN
# keeps those two years, a day's build only two weeks), its
# win64-gpl-shared-<major> zip and that zip's line in the release's
# checksums.sha256, the commit the tag points at, the FFmpeg branch in
# BTBN_BUILD, and FFmpeg's commit from the zip's name
# (n<version>-<n>-g<commit>).
BTBN_TAG=autobuild-2026-09-30-13-08
BTBN_COMMIT=6c9aec5fc9a72ec3abedd1fa84db141fa18cf52b
BTBN_ASSET=ffmpeg-n9.0.2-17-g2a571b6068-win64-gpl-shared-9.0.zip
BTBN_SHA256=3da6c7b60bb9ccd73ec5b5e815ba804a0879eb362ba0e3beebce50174c022696
# The build that zip is of: FFmpeg-Builds' ./build.sh arguments (target,
# variant, FFmpeg branch), from its name.
BTBN_BUILD=win64 gpl-shared 9.0
FFMPEG_VERSION=n9.0.2-17-g2a571b6068
FFMPEG_COMMIT=2a571b6068
