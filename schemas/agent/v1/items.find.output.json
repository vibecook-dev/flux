{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`items.find` output.",
  "properties": {
    "items": {
      "items": {
        "description": "An item, briefly: what lists return.",
        "properties": {
          "available": {
            "description": "`false` when none of its files is on a drive that answers.",
            "type": "boolean"
          },
          "gaps": {
            "description": "What it lacks; empty when nothing is missing.",
            "items": {
              "description": "Something an item lacks: what `library.gaps` counts and `items.find` filters by.",
              "oneOf": [
                {
                  "const": "identity",
                  "description": "Not identified: no provider match, and neither you nor an agent set its title or ids. Films and shows.",
                  "type": "string"
                },
                {
                  "const": "year",
                  "description": "No year. Films and shows.",
                  "type": "string"
                },
                {
                  "const": "overview",
                  "description": "No description. Films and shows.",
                  "type": "string"
                },
                {
                  "const": "poster",
                  "description": "No poster but flux's own (a frame of the video, or AI art), or none. Films and shows.",
                  "type": "string"
                },
                {
                  "const": "backdrop",
                  "description": "No backdrop but flux's own, or none. Films and shows.",
                  "type": "string"
                },
                {
                  "const": "episode_titles",
                  "description": "Episodes still titled \"Episode N\": shows that have some, and those episodes.",
                  "type": "string"
                },
                {
                  "const": "offline",
                  "description": "No file on a drive that answers.",
                  "type": "string"
                }
              ]
            },
            "type": "array"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "movie",
              "show",
              "season",
              "episode",
              "extra"
            ],
            "type": "string"
          },
          "library": {
            "format": "int64",
            "type": "integer"
          },
          "match_state": {
            "description": "How flux identified an item.",
            "oneOf": [
              {
                "const": "unmatched",
                "description": "Not even the name could be read.",
                "type": "string"
              },
              {
                "const": "parsed",
                "description": "Named from the file only (or offline suggestions): nobody has confirmed what it is.",
                "type": "string"
              },
              {
                "const": "matched",
                "description": "A metadata provider confirmed it.",
                "type": "string"
              },
              {
                "const": "locked",
                "description": "Settled by hand (flux matches it no more).",
                "type": "string"
              }
            ]
          },
          "parent": {
            "description": "A season's show, an episode's season, an extra's film or show.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "path": {
            "description": "The first file's path (films, episodes, videos), or the show's first folder.",
            "type": [
              "string",
              "null"
            ]
          },
          "poster": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "const": "provider",
                    "description": "From a metadata provider (TMDB, fanart.tv…), with attribution.",
                    "type": "string"
                  },
                  {
                    "const": "local",
                    "description": "A poster/thumb file next to the media.",
                    "type": "string"
                  },
                  {
                    "const": "frame",
                    "description": "A frame picked from the video plus typeset title (no AI).",
                    "type": "string"
                  },
                  {
                    "const": "generated",
                    "description": "AI-generated; always labelled as such in the UI.",
                    "type": "string"
                  },
                  {
                    "const": "custom",
                    "description": "Chosen by you or your agent (`art.add`): found elsewhere and credited ([`ArtRef::attribution`]), or made without AI. Shown over every other image of its kind.",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Where the poster it shows comes from; `null`: it has none."
          },
          "subtitle": {
            "description": "`S01E03` for episodes, the season's name for seasons.",
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "description": "The title as you may see it: one from a withheld provider is replaced by the title the file gives.",
            "type": "string"
          },
          "year": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "library",
          "title",
          "match_state",
          "gaps",
          "available"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "next": {
      "description": "Pass as `cursor` for the next page; `null` at the end.",
      "type": [
        "string",
        "null"
      ]
    },
    "total": {
      "description": "Items matching, on every page.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "items",
    "total"
  ],
  "title": "FindOutput",
  "type": "object"
}
