{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`collection.get` output: its titles, those picked first (in order), then those its rule takes (by title).",
  "properties": {
    "collection": {
      "description": "A collection kept on the server.",
      "properties": {
        "added_by": {
          "description": "Who made it (a login).",
          "type": "string"
        },
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "count": {
          "description": "Titles in it now.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cover": {
          "description": "The first few titles (ids), for a cover.",
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "created_at": {
          "format": "int64",
          "type": "integer"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "everyone": {
          "type": "boolean"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "rule": {
          "additionalProperties": false,
          "description": "The titles a rule takes into a collection: those that match every condition given (in a list, any of its values; names in any case). As the library changes, so does the collection.",
          "properties": {
            "countries": {
              "description": "ISO 3166-1 codes (`JP`).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "genres": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kinds": {
              "description": "`movie`, `show` (default: both).",
              "items": {
                "enum": [
                  "movie",
                  "show",
                  "season",
                  "episode",
                  "extra"
                ],
                "type": "string"
              },
              "type": "array"
            },
            "languages": {
              "description": "ISO 639-1 codes (`ja`).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "libraries": {
              "description": "In these libraries (default: every film and show library).",
              "items": {
                "format": "int64",
                "type": "integer"
              },
              "type": "array"
            },
            "people": {
              "description": "Directed, written by or starring any of these.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "studios": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "tags": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "text": {
              "description": "Text in the title or the original title.",
              "type": [
                "string",
                "null"
              ]
            },
            "year_from": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "year_to": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "sources": {
          "items": {
            "description": "A web page or file that supports a value, or a link to keep. In an input, a plain URL string is read as a link without a title.",
            "properties": {
              "title": {
                "description": "What it is (\"Wikipedia\", \"Official site\", \"Festival programme\").",
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "description": "An `http` or `https` URL.",
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "updated_at": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "everyone",
        "count",
        "cover",
        "added_by",
        "sources",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "items": {
      "items": {
        "description": "An item, briefly: what lists return.",
        "properties": {
          "available": {
            "description": "`false` when none of its files is on a drive that answers.",
            "type": "boolean"
          },
          "gaps": {
            "description": "What it lacks; empty when nothing is missing.",
            "items": {
              "description": "Something an item lacks: what `library.gaps` counts and `items.find` filters by.",
              "oneOf": [
                {
                  "const": "identity",
                  "description": "Not identified: no provider match, and neither you nor an agent set its title or ids. Films and shows.",
                  "type": "string"
                },
                {
                  "const": "year",
                  "description": "No year. Films and shows.",
                  "type": "string"
                },
                {
                  "const": "overview",
                  "description": "No description. Films and shows.",
                  "type": "string"
                },
                {
                  "const": "poster",
                  "description": "No poster but flux's own (a frame of the video, or AI art), or none. Films and shows.",
                  "type": "string"
                },
                {
                  "const": "backdrop",
                  "description": "No backdrop but flux's own, or none. Films and shows.",
                  "type": "string"
                },
                {
                  "const": "episode_titles",
                  "description": "Episodes still titled \"Episode N\": shows that have some, and those episodes.",
                  "type": "string"
                },
                {
                  "const": "offline",
                  "description": "No file on a drive that answers.",
                  "type": "string"
                }
              ]
            },
            "type": "array"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "movie",
              "show",
              "season",
              "episode",
              "extra"
            ],
            "type": "string"
          },
          "library": {
            "format": "int64",
            "type": "integer"
          },
          "match_state": {
            "description": "How flux identified an item.",
            "oneOf": [
              {
                "const": "unmatched",
                "description": "Not even the name could be read.",
                "type": "string"
              },
              {
                "const": "parsed",
                "description": "Named from the file only (or offline suggestions): nobody has confirmed what it is.",
                "type": "string"
              },
              {
                "const": "matched",
                "description": "A metadata provider confirmed it.",
                "type": "string"
              },
              {
                "const": "locked",
                "description": "Settled by hand (flux matches it no more).",
                "type": "string"
              }
            ]
          },
          "parent": {
            "description": "A season's show, an episode's season, an extra's film or show.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "path": {
            "description": "The first file's path (films, episodes, videos), or the show's first folder.",
            "type": [
              "string",
              "null"
            ]
          },
          "poster": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "const": "provider",
                    "description": "From a metadata provider (TMDB, fanart.tv…), with attribution.",
                    "type": "string"
                  },
                  {
                    "const": "local",
                    "description": "A poster/thumb file next to the media.",
                    "type": "string"
                  },
                  {
                    "const": "frame",
                    "description": "A frame picked from the video plus typeset title (no AI).",
                    "type": "string"
                  },
                  {
                    "const": "generated",
                    "description": "AI-generated; always labelled as such in the UI.",
                    "type": "string"
                  },
                  {
                    "const": "custom",
                    "description": "Chosen by you or your agent (`art.add`): found elsewhere and credited ([`ArtRef::attribution`]), or made without AI. Shown over every other image of its kind.",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Where the poster it shows comes from; `null`: it has none."
          },
          "subtitle": {
            "description": "`S01E03` for episodes, the season's name for seasons.",
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "description": "The title as you may see it: one from a withheld provider is replaced by the title the file gives.",
            "type": "string"
          },
          "year": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "library",
          "title",
          "match_state",
          "gaps",
          "available"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "next": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Why a picked title is there, by id.",
      "type": "object"
    },
    "total": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "collection",
    "items",
    "notes",
    "total"
  ],
  "title": "CollectionItems",
  "type": "object"
}
