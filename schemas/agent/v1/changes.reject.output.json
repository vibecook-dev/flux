{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`changes.undo`, `changes.apply` and `changes.reject` output.",
  "properties": {
    "changeset": {
      "description": "A changeset, briefly.",
      "properties": {
        "agent": {
          "description": "The agent that made it; `null` for a person.",
          "type": [
            "string",
            "null"
          ]
        },
        "by": {
          "description": "The person it was made by, or for (a login).",
          "type": "string"
        },
        "change_count": {
          "description": "How many changes it holds.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "created_at": {
          "format": "int64",
          "type": "integer"
        },
        "decided_at": {
          "description": "Applied or rejected.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "decided_by": {
          "description": "Who applied or rejected a proposal.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "item_count": {
          "description": "How many items it changes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "moves_files": {
          "description": "It renames or moves files on disk (a file plan, `files.plan`).",
          "type": "boolean"
        },
        "reverted_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "reverted_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "oneOf": [
            {
              "enum": [
                "applied"
              ],
              "type": "string"
            },
            {
              "const": "proposed",
              "description": "Waiting for an Owner or Admin.",
              "type": "string"
            },
            {
              "const": "reverted",
              "description": "Undone.",
              "type": "string"
            },
            {
              "const": "rejected",
              "description": "A proposal turned down.",
              "type": "string"
            }
          ]
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "state",
        "summary",
        "by",
        "created_at",
        "item_count",
        "change_count",
        "moves_files"
      ],
      "type": "object"
    },
    "done": {
      "description": "Changes undone, or applied.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "not_done": {
      "description": "Changes left as they were, and why.",
      "items": {
        "description": "A change that couldn't be applied or undone, and why.",
        "properties": {
          "field": {
            "type": "string"
          },
          "item": {
            "format": "int64",
            "type": "integer"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "item",
          "field",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "changeset",
    "done",
    "not_done"
  ],
  "title": "Decided",
  "type": "object"
}
