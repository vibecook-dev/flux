{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`items.find` input. Every filter is optional; they combine.",
  "properties": {
    "cursor": {
      "description": "`next` from the previous page.",
      "type": [
        "string",
        "null"
      ]
    },
    "gap": {
      "anyOf": [
        {
          "description": "Something an item lacks: what `library.gaps` counts and `items.find` filters by.",
          "oneOf": [
            {
              "const": "identity",
              "description": "Not identified: no provider match, and neither you nor an agent set its title or ids. Films and shows.",
              "type": "string"
            },
            {
              "const": "year",
              "description": "No year. Films and shows.",
              "type": "string"
            },
            {
              "const": "overview",
              "description": "No description. Films and shows.",
              "type": "string"
            },
            {
              "const": "poster",
              "description": "No poster but flux's own (a frame of the video, or AI art), or none. Films and shows.",
              "type": "string"
            },
            {
              "const": "backdrop",
              "description": "No backdrop but flux's own, or none. Films and shows.",
              "type": "string"
            },
            {
              "const": "episode_titles",
              "description": "Episodes still titled \"Episode N\": shows that have some, and those episodes.",
              "type": "string"
            },
            {
              "const": "offline",
              "description": "No file on a drive that answers.",
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "description": "Without `parent`, the default is top-level items (films, shows, videos); `episode` finds episodes across shows.",
      "enum": [
        "movie",
        "show",
        "season",
        "episode",
        "extra",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "library": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "limit": {
      "description": "1–200, default 50.",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "match_state": {
      "anyOf": [
        {
          "description": "How flux identified an item.",
          "oneOf": [
            {
              "const": "unmatched",
              "description": "Not even the name could be read.",
              "type": "string"
            },
            {
              "const": "parsed",
              "description": "Named from the file only (or offline suggestions): nobody has confirmed what it is.",
              "type": "string"
            },
            {
              "const": "matched",
              "description": "A metadata provider confirmed it.",
              "type": "string"
            },
            {
              "const": "locked",
              "description": "Settled by hand (flux matches it no more).",
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "parent": {
      "description": "Items below this one: a show's seasons and episodes, a season's episodes, a film's extras.",
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "q": {
      "description": "Text in the title (as you may see it) or in a file's path, any case.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "FindInput",
  "type": "object"
}
