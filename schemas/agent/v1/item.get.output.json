{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`item.get`: one item as an agent sees it.",
  "properties": {
    "art": {
      "items": {
        "description": "One image of an item.",
        "properties": {
          "credit": {
            "description": "Who it's credited to.",
            "type": [
              "string",
              "null"
            ]
          },
          "found_at": {
            "description": "The page it came from.",
            "type": [
              "string",
              "null"
            ]
          },
          "generator": {
            "description": "The AI model that made it (for `generated`).",
            "type": [
              "string",
              "null"
            ]
          },
          "height": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "kind": {
            "description": "Image kinds.",
            "oneOf": [
              {
                "const": "poster",
                "description": "2:3, with the title.",
                "type": "string"
              },
              {
                "const": "backdrop",
                "description": "16:9, without text.",
                "type": "string"
              },
              {
                "const": "thumb",
                "description": "An episode's still, 16:9.",
                "type": "string"
              },
              {
                "const": "logo",
                "description": "The title as a transparent logo.",
                "type": "string"
              }
            ]
          },
          "pinned": {
            "description": "Chosen by hand: it shows until unpinned.",
            "type": "boolean"
          },
          "shown": {
            "description": "The image the item shows for its kind.",
            "type": "boolean"
          },
          "source": {
            "description": "`frame` and `generated` are flux's own (a frame of the video; AI art); `custom` was chosen by you or an agent; `provider` and `local` came from a provider or a file beside the video.",
            "oneOf": [
              {
                "const": "provider",
                "description": "From a metadata provider (TMDB, fanart.tv…), with attribution.",
                "type": "string"
              },
              {
                "const": "local",
                "description": "A poster/thumb file next to the media.",
                "type": "string"
              },
              {
                "const": "frame",
                "description": "A frame picked from the video plus typeset title (no AI).",
                "type": "string"
              },
              {
                "const": "generated",
                "description": "AI-generated; always labelled as such in the UI.",
                "type": "string"
              },
              {
                "const": "custom",
                "description": "Chosen by you or your agent (`art.add`): found elsewhere and credited ([`ArtRef::attribution`]), or made without AI. Shown over every other image of its kind.",
                "type": "string"
              }
            ]
          },
          "url": {
            "description": "Where to fetch it (or use `art.view`); `null` when withheld.",
            "type": [
              "string",
              "null"
            ]
          },
          "width": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "withheld": {
            "description": "The provider it's withheld for (its terms forbid use with AI).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "source",
          "shown",
          "pinned"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "available": {
      "description": "`false` when none of its files is on a drive that answers.",
      "type": "boolean"
    },
    "changes": {
      "description": "The latest changesets that changed it, newest first.",
      "items": {
        "description": "A changeset, briefly.",
        "properties": {
          "agent": {
            "description": "The agent that made it; `null` for a person.",
            "type": [
              "string",
              "null"
            ]
          },
          "by": {
            "description": "The person it was made by, or for (a login).",
            "type": "string"
          },
          "change_count": {
            "description": "How many changes it holds.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "created_at": {
            "format": "int64",
            "type": "integer"
          },
          "decided_at": {
            "description": "Applied or rejected.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "decided_by": {
            "description": "Who applied or rejected a proposal.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "item_count": {
            "description": "How many items it changes.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "reverted_at": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "reverted_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "oneOf": [
              {
                "enum": [
                  "applied"
                ],
                "type": "string"
              },
              {
                "const": "proposed",
                "description": "Waiting for an Owner or Admin.",
                "type": "string"
              },
              {
                "const": "reverted",
                "description": "Undone.",
                "type": "string"
              },
              {
                "const": "rejected",
                "description": "A proposal turned down.",
                "type": "string"
              }
            ]
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "state",
          "summary",
          "by",
          "created_at",
          "item_count",
          "change_count"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "children": {
      "description": "A show's seasons, a season's episodes, a film's extras.",
      "items": {
        "description": "An item, briefly: what lists return.",
        "properties": {
          "available": {
            "description": "`false` when none of its files is on a drive that answers.",
            "type": "boolean"
          },
          "gaps": {
            "description": "What it lacks; empty when nothing is missing.",
            "items": {
              "description": "Something an item lacks: what `library.gaps` counts and `items.find` filters by.",
              "oneOf": [
                {
                  "const": "identity",
                  "description": "Not identified: no provider match, and neither you nor an agent set its title or ids. Films and shows.",
                  "type": "string"
                },
                {
                  "const": "year",
                  "description": "No year. Films and shows.",
                  "type": "string"
                },
                {
                  "const": "overview",
                  "description": "No description. Films and shows.",
                  "type": "string"
                },
                {
                  "const": "poster",
                  "description": "No poster but flux's own (a frame of the video, or AI art), or none. Films and shows.",
                  "type": "string"
                },
                {
                  "const": "backdrop",
                  "description": "No backdrop but flux's own, or none. Films and shows.",
                  "type": "string"
                },
                {
                  "const": "episode_titles",
                  "description": "Episodes still titled \"Episode N\": shows that have some, and those episodes.",
                  "type": "string"
                },
                {
                  "const": "offline",
                  "description": "No file on a drive that answers.",
                  "type": "string"
                }
              ]
            },
            "type": "array"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "movie",
              "show",
              "season",
              "episode",
              "extra"
            ],
            "type": "string"
          },
          "library": {
            "format": "int64",
            "type": "integer"
          },
          "match_state": {
            "description": "How flux identified an item.",
            "oneOf": [
              {
                "const": "unmatched",
                "description": "Not even the name could be read.",
                "type": "string"
              },
              {
                "const": "parsed",
                "description": "Named from the file only (or offline suggestions): nobody has confirmed what it is.",
                "type": "string"
              },
              {
                "const": "matched",
                "description": "A metadata provider confirmed it.",
                "type": "string"
              },
              {
                "const": "locked",
                "description": "Settled by hand (flux matches it no more).",
                "type": "string"
              }
            ]
          },
          "parent": {
            "description": "A season's show, an episode's season, an extra's film or show.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "path": {
            "description": "The first file's path (films, episodes, videos), or the show's first folder.",
            "type": [
              "string",
              "null"
            ]
          },
          "poster": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "const": "provider",
                    "description": "From a metadata provider (TMDB, fanart.tv…), with attribution.",
                    "type": "string"
                  },
                  {
                    "const": "local",
                    "description": "A poster/thumb file next to the media.",
                    "type": "string"
                  },
                  {
                    "const": "frame",
                    "description": "A frame picked from the video plus typeset title (no AI).",
                    "type": "string"
                  },
                  {
                    "const": "generated",
                    "description": "AI-generated; always labelled as such in the UI.",
                    "type": "string"
                  },
                  {
                    "const": "custom",
                    "description": "Chosen by you or your agent (`art.add`): found elsewhere and credited ([`ArtRef::attribution`]), or made without AI. Shown over every other image of its kind.",
                    "type": "string"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Where the poster it shows comes from; `null`: it has none."
          },
          "subtitle": {
            "description": "`S01E03` for episodes, the season's name for seasons.",
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "description": "The title as you may see it: one from a withheld provider is replaced by the title the file gives.",
            "type": "string"
          },
          "year": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "library",
          "title",
          "match_state",
          "gaps",
          "available"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "episode_numbers": {
      "items": {
        "format": "uint16",
        "maximum": 65535,
        "minimum": 0,
        "type": "integer"
      },
      "type": "array"
    },
    "fields": {
      "additionalProperties": false,
      "description": "Every field you can set, with its value now (`null`: empty, or withheld).",
      "properties": {
        "air_date": {
          "description": "Episodes: when it first aired, `YYYY-MM-DD`.",
          "type": [
            "string",
            "null"
          ]
        },
        "cast": {
          "description": "Top-billed cast, in billing order (at most 100).",
          "items": {
            "description": "One credited performer.",
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "description": "The part they play, or what they do (\"Narrator\", \"Herself\").",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "content_rating": {
          "description": "A rating such as `PG-13`, `12`, `TV-MA`, with no country prefix.",
          "type": [
            "string",
            "null"
          ]
        },
        "countries": {
          "description": "Countries of production, as ISO 3166-1 alpha-2 codes (`JP`, `FR`).",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "directors": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "genres": {
          "description": "Genres, in English, capitalised: `[\"Documentary\", \"Music\"]`.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "ids": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Ids in other databases, by provider: `tmdb` (number), `imdb` (`tt…`), `tvdb` (number), `wikidata` (`Q…`), or any other (`anidb`, `musicbrainz`, `letterboxd`, …). In `items.edit` the ids given are added or replaced; the others stay. With a metadata provider configured, ids you set make flux match by id instead of by title.",
          "type": [
            "object",
            "null"
          ]
        },
        "languages": {
          "description": "Spoken languages, as ISO 639-1 codes where one exists (`ja`, `en`, `zh-Hant`).",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "links": {
          "description": "Pages worth keeping with it: official site, encyclopaedia entries, an archive page, the festival listing.",
          "items": {
            "description": "A web page or file that supports a value, or a link to keep. In an input, a plain URL string is read as a link without a title.",
            "properties": {
              "title": {
                "description": "What it is (\"Wikipedia\", \"Official site\", \"Festival programme\").",
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "description": "An `http` or `https` URL.",
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "original_title": {
          "description": "The title in its original language and script (`千と千尋の神隠し`), when it differs. Search finds both.",
          "type": [
            "string",
            "null"
          ]
        },
        "overview": {
          "description": "What it's about, two to five sentences, in your own words: never copied from a provider (and never from TMDB).",
          "type": [
            "string",
            "null"
          ]
        },
        "release_date": {
          "description": "First release: `YYYY-MM-DD`, `YYYY-MM` or `YYYY`.",
          "type": [
            "string",
            "null"
          ]
        },
        "studios": {
          "description": "Studios, labels or (for shows) networks.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "tagline": {
          "description": "A one-line hook, if it has a well-known one.",
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "description": "Your own labels, for collections and search: `[\"Studio Ghibli\", \"Concert\", \"Festival short\"]`.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "title": {
          "description": "The title to show: the film's or show's best-known title in the library's language, the season's name, the episode's title.",
          "type": [
            "string",
            "null"
          ]
        },
        "writers": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "year": {
          "description": "The year of first release (a show's first season).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "files": {
      "description": "The item's own files (films, episodes, videos, extras; a show's and a season's files are on their episodes).",
      "items": {
        "description": "One file of an item and what flux read from it: the evidence to identify it by.",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "chapters": {
            "description": "Chapter names, when the file names its chapters (at most 50).",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "container": {
            "description": "\"Matroska\", \"MP4\"…",
            "type": [
              "string",
              "null"
            ]
          },
          "container_title": {
            "description": "The title stored inside the file, if any.",
            "type": [
              "string",
              "null"
            ]
          },
          "duration_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "edition": {
            "description": "Edition flux read from the name (\"Director's Cut\").",
            "type": [
              "string",
              "null"
            ]
          },
          "fix": {
            "additionalProperties": false,
            "description": "What the file was fixed to be (`files.fix`), which flux places it by instead of its name; `null`: its name decides.",
            "properties": {
              "edition": {
                "description": "A film version's edition (\"Director's Cut\").",
                "type": [
                  "string",
                  "null"
                ]
              },
              "episodes": {
                "description": "An episode's number, or its numbers for a file that holds several (`[1, 2]`).",
                "items": {
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "extra": {
                "description": "An extra's kind.",
                "enum": [
                  "trailer",
                  "featurette",
                  "behind_the_scenes",
                  "deleted_scene",
                  "interview",
                  "short",
                  "scene",
                  "other",
                  null
                ],
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "anyOf": [
                  {
                    "description": "What a file is, when flux's reading of its name is wrong.",
                    "oneOf": [
                      {
                        "const": "movie",
                        "description": "A film, or one version of a film.",
                        "type": "string"
                      },
                      {
                        "const": "episode",
                        "description": "An episode of a show.",
                        "type": "string"
                      },
                      {
                        "const": "extra",
                        "description": "Bonus material of a film or show: a trailer, a featurette…",
                        "type": "string"
                      },
                      {
                        "const": "ignore",
                        "description": "Not part of the library (a sample, a stray clip): flux keeps the file but shows it nowhere.",
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "of": {
                "description": "The film or show it belongs to: a top-level item of its library. A film's other version, a show's episode, an extra's film or show.",
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "part": {
                "description": "A film's part, for one split over files (2 for `cd2`).",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "season": {
                "description": "An episode's season (0 for specials).",
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "title": {
                "description": "The title to group it under, as if its name said it: a film's title, or an episode's show.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "year": {
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "id": {
            "description": "The file, for `files.fix` and `files.plan`.",
            "format": "int64",
            "type": "integer"
          },
          "modified": {
            "description": "Last modified (Unix ms): for home videos, often when it was filmed.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "parsed": {
            "description": "What flux read from the file's name and folders.",
            "properties": {
              "absolute_episode": {
                "description": "Anime-style absolute episode number.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "air_date": {
                "description": "Date-based shows, `YYYY-MM-DD`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidence": {
                "description": "0.0–1.0. Below ~0.5 the item is queued for AI-assisted matching.",
                "format": "float",
                "type": "number"
              },
              "edition": {
                "description": "\"Director's Cut\", \"Extended Edition\", …",
                "type": [
                  "string",
                  "null"
                ]
              },
              "episode_title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "episodes": {
                "description": "One entry normally; several for multi-episode files (S01E01-E02).",
                "items": {
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              },
              "evidence": {
                "description": "Which rules fired, for explainability (\"fast path: Show/Season NN/…\").",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "extra": {
                "enum": [
                  "trailer",
                  "featurette",
                  "behind_the_scenes",
                  "deleted_scene",
                  "interview",
                  "short",
                  "scene",
                  "other",
                  null
                ],
                "type": [
                  "string",
                  "null"
                ]
              },
              "ids": {
                "description": "External ids embedded in paths, e.g. `[tmdbid-603]`, `{imdb-tt0133093}`.",
                "properties": {
                  "imdb": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "tmdb": {
                    "format": "uint64",
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "tvdb": {
                    "format": "uint64",
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "type": "object"
              },
              "kind": {
                "oneOf": [
                  {
                    "enum": [
                      "movie",
                      "episode",
                      "unknown"
                    ],
                    "type": "string"
                  },
                  {
                    "const": "extra",
                    "description": "Bonus material attached to a movie or show (trailers, featurettes, …).",
                    "type": "string"
                  },
                  {
                    "const": "sample",
                    "description": "A release \"sample\" clip; never shown as a library item.",
                    "type": "string"
                  }
                ]
              },
              "original_title": {
                "description": "The other-script half of a bilingual name (`示例剧.Some.Show.S01E01…` → title \"Some Show\", original title \"示例剧\"). The catalog stores it as the item's `original_title`, so search finds both names.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "part": {
                "description": "Multi-part movies (`cd1`, `part2`).",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "release_group": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "resolution": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "season": {
