{
  "name": "flux-web",
  "private": true,
  "version": "0.1.0-alpha.3",
  "type": "module",
  "description": "flux web client: React 19 + TypeScript + Vite, hls.js playback, talks flux_core::api",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibecook-dev/flux.git",
    "directory": "web"
  },
  "homepage": "https://github.com/vibecook-dev/flux",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "golden": "node scripts/gen-golden.mjs",
    "sizes": "node scripts/bundle-sizes.mjs",
    "screens": "node scripts/screens.mjs",
    "bench:grid": "node scripts/bench-grid.mjs",
    "bench:playback": "node scripts/bench-playback.mjs",
    "bench:audio": "nice -n 19 node scripts/bench-audio-switch.mjs",
    "e2e": "nice -n 19 sh -c 'node scripts/e2e-product.mjs && node scripts/e2e-bench.mjs && node scripts/e2e-playback.mjs'",
    "e2e:product": "nice -n 19 node scripts/e2e-product.mjs",
    "e2e:bench": "nice -n 19 node scripts/e2e-bench.mjs",
    "e2e:playback": "nice -n 19 node scripts/e2e-playback.mjs",
    "mock-media": "bash scripts/make-mock-media.sh"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "blurhash": "2.0.5",
    "hls.js": "1.7.3",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "2.15.0",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
