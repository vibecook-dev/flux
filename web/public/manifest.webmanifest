{
  "id": "./",
  "name": "flux",
  "short_name": "flux",
  "description": "Your movie and TV library, private and instant.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "background_color": "#0b0b0e",
